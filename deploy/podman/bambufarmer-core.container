[Unit]
Description=BambuFarmer core
After=bambufarmer-postgres.service bambufarmer-redis.service

[Container]
Image=localhost/bambufarmer-core:dev
ContainerName=bambufarmer-core
Network=bambufarmer.network
PublishPort=18081:8080
Environment=HTTP_ADDR=:8080
Environment=DATABASE_URL=postgres://bambufarmer:bambufarmer@bambufarmer-postgres:5432/bambufarmer?sslmode=disable
Environment=REDIS_URL=redis://bambufarmer-redis:6379/0

[Service]
Restart=always

[Install]
WantedBy=default.target
