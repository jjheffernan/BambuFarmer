# Copy to deploy/.env or export before: podman compose -f deploy/compose.yml up -d
# See docs/DESIGN_SPEC.md §13, deploy/podman/README.md, and docs/MVP_CHECKLIST.md.

# --- Auth (gateway) ---
AUTH_MODE=local_insecure
# AUTH_MODE=oidc
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=
SESSION_SECRET=change-me

# --- Backing services ---
DATABASE_URL=postgres://bambufarmer:bambufarmer@postgres:5432/bambufarmer?sslmode=disable
REDIS_URL=redis://redis:6379/0
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=bambufarmer

# --- Edge / Farm Manager ---
SITE_ID=default
FARM_MODE=farm_manager
FARM_MANAGER_URL=https://192.168.1.20:8888
FARM_MANAGER_TRANSPORT=cdp
# FARM_MANAGER_TRANSPORT=direct
FARM_MANAGER_USER=admin
FARM_MANAGER_PASSWORD=
# EDGE_CERT_DIR=/certs
# CDP_URL=http://127.0.0.1:9222
EDGE_TOKEN=change-me-edge-token

# --- Integrations (leave empty for stub mode) ---
SPOOLMAN_URL=
SPOOLMAN_API_TOKEN=
MANYFOLD_URL=
MANYFOLD_CLIENT_ID=
MANYFOLD_CLIENT_SECRET=

# --- Costing defaults ---
CURRENCY=USD
