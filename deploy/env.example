# Copy to deploy/.env or export before: podman compose -f deploy/compose.yml up -d
# See docs/DESIGN_SPEC.md §13, deploy/podman/README.md, and docs/MVP_CHECKLIST.md.

# --- Auth (gateway) ---
# lan = insecure LAN mode (default; no public URL / IdP)
# oidc = secured URL'd deploy
AUTH_MODE=lan
# AUTH_MODE=local_insecure   # alias of lan
# AUTH_MODE=oidc
# OIDC_ISSUER=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=
SESSION_SECRET=change-me

# --- Backing services ---
DATABASE_URL=postgres://bambufarmer:bambufarmer@postgres:5432/bambufarmer?sslmode=disable
REDIS_URL=redis://redis:6379/0
# Optional object store (compose --profile object)
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=minioadmin
OBJECT_STORE_BUCKET=bambufarmer

# --- Edge / Farm Manager (mirror FM Client) ---
SITE_ID=default
FARM_MODE=farm_manager
FARM_MANAGER_URL=https://192.168.1.20:8888
FARM_MANAGER_TRANSPORT=fm_native
# FARM_MANAGER_TRANSPORT=cdp          # escape hatch via FM Client DevTools
FARM_MANAGER_USER=admin
FARM_MANAGER_PASSWORD=
# EDGE_CERT_DIR=/certs
# CDP_URL=http://127.0.0.1:9222
EDGE_TOKEN=change-me-edge-token

# --- Integrations (optional live URLs; leave empty to disable) ---
SPOOLMAN_URL=
SPOOLMAN_API_TOKEN=
MANYFOLD_URL=
MANYFOLD_CLIENT_ID=
MANYFOLD_CLIENT_SECRET=
# MANYFOLD_TOKEN=                     # optional non-OAuth bearer when allowed

# --- Costing defaults ---
CURRENCY=USD
MACHINE_RATE_PER_HOUR=0              # $/hr
FILAMENT_PRICE_PER_KG=0              # $/kg
FILAMENT_KG_PER_HOUR=0               # kg/hr (estimate throughput)
