# --- Binaries / build ---
bin/
dist/
*.exe
*.dll
*.so
*.dylib
*.test
*.out
*.o
*.a
coverage.out
coverage.html
*.coverprofile

# --- Go ---
vendor/
# local module cache / workspace overrides
.gomodcache/

# --- Node (web Tailwind) ---
services/web/node_modules/
services/web/tmp/
npm-debug.log*
yarn-error.log*

# --- Env / secrets (commit *.example only) ---
.env
.env.*
!.env.example
!.env.*.example
deploy/.env
deploy/.env.*
!deploy/env.example
*.pem
*.key
*.p12
*.pfx
*.crt
!**/testdata/**/*.crt
certs/
secrets/
credentials.json
**/credentials.json
service-account*.json
*.kubeconfig

# --- SQL dumps / ad-hoc scripts (schema lives in Go under packages/db) ---
*.sql
!**/testdata/**/*.sql

# --- Local data / snapshots ---
data/
.minio/
deploy/snapshots/*
!deploy/snapshots/.gitkeep
*.dump

# --- IDE / OS ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.log

# --- Templ / generated ---
**/*.templ.go

# --- Misc ---
.direnv/
.venv/
venv/
__pycache__/
.cache/
tmp/
*.tmp

# --- Local research / third-party trees (never commit) ---
.reference/
third_party/
third-party/
vendor_ref/
*_upstream/
*.clone/

