# bambufarmer-gateway — standalone image (one binary, distroless)
# podman build -t localhost/bambufarmer-gateway:dev -f services/gateway/Containerfile .
FROM golang:1.26-bookworm AS build
WORKDIR /src
ENV GOWORK=off
COPY packages/api ./packages/api
COPY packages/httpserver ./packages/httpserver
COPY packages/events ./packages/events
COPY services/gateway ./services/gateway
WORKDIR /src/services/gateway
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/service .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/service /service
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/service"]
