# bambufarmer-edge — standalone image (one binary, distroless)
# Keep on printer LAN; do not combine with web/gateway.
# podman build -t localhost/bambufarmer-edge:dev -f services/edge/Containerfile .
FROM golang:1.26-bookworm AS build
WORKDIR /src
ENV GOWORK=off
COPY packages/api ./packages/api
COPY packages/httpserver ./packages/httpserver
COPY packages/printerstate ./packages/printerstate
COPY packages/events ./packages/events
COPY packages/farm ./packages/farm
COPY packages/objectstore ./packages/objectstore
COPY services/edge ./services/edge
WORKDIR /src/services/edge
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/service .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/service /service
COPY fixtures/fm /fixtures/fm
USER nonroot:nonroot
EXPOSE 8080
ENV EDGE_FIXTURE_DIR=/fixtures/fm
ENTRYPOINT ["/service"]
