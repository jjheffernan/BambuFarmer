# bambufarmer-integrations — standalone image (one binary, distroless)
# podman build -t localhost/bambufarmer-integrations:dev -f services/integrations/Containerfile .
FROM golang:1.23-bookworm AS build
WORKDIR /src
ENV GOWORK=off
COPY packages/api ./packages/api
COPY packages/httpserver ./packages/httpserver
COPY services/integrations ./services/integrations
WORKDIR /src/services/integrations
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/service .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/service /service
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/service"]
