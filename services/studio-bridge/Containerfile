# bambufarmer-studio-bridge — optional Studio/Orca receive plugin (compose --profile studio-bridge)
# podman build -t localhost/bambufarmer-studio-bridge:dev -f services/studio-bridge/Containerfile .
FROM golang:1.26-bookworm AS build
WORKDIR /src
ENV GOWORK=off
COPY packages/api ./packages/api
COPY packages/events ./packages/events
COPY packages/httpserver ./packages/httpserver
COPY services/studio-bridge ./services/studio-bridge
WORKDIR /src/services/studio-bridge
RUN go mod tidy && CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/service .

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/service /service
USER nonroot:nonroot
EXPOSE 8080
ENTRYPOINT ["/service"]
