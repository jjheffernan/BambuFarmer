# BambuFarmer secrets & config template
# -----------------------------------------------------------------------------
#   cp .env.example .env
#   # edit .env — never commit .env
#
# Compose loads this file from the repo root (see deploy/compose.yml env_file).
# Modes & placement: docs/DEPLOYMENT_MODES.md
# -----------------------------------------------------------------------------

# === Auth (gateway) ==========================================================
# lan  = insecure LAN mode (default). Private network / VPN only. No IdP.
# oidc = URL'd / SSO deploy. Requires OIDC_* below. Use whenever UI has a real URL.
# local_insecure = alias of lan
AUTH_MODE=lan

# Required for signed session cookies (LAN login). Use a long random string.
SESSION_SECRET=change-me-to-a-long-random-string
# Set true when serving HTTPS so the session cookie gets Secure.
# SESSION_SECURE=false

# --- OIDC (only when AUTH_MODE=oidc) ---
# OIDC_ISSUER=https://idp.example.com/realms/bambufarmer
# OIDC_CLIENT_ID=bambufarmer
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://farm.example.com/api/v1/auth/callback

# === Postgres ================================================================
POSTGRES_USER=bambufarmer
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=bambufarmer
# Compose services use host "postgres"; override only for external DB.
DATABASE_URL=postgres://bambufarmer:change-me-postgres@postgres:5432/bambufarmer?sslmode=disable

# === Redis ===================================================================
REDIS_URL=redis://redis:6379/0

# === Object store (optional: compose --profile object) =======================
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_ACCESS_KEY=minio
OBJECT_STORE_SECRET_KEY=change-me-minio
OBJECT_STORE_BUCKET=bambufarmer
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio

# === Site / edge / Farm Manager ==============================================
# Edge must reach Farm Manager on the printer LAN in every deploy mode.
SITE_ID=default
FARM_MODE=farm_manager
FARM_MANAGER_URL=http://192.168.1.20:8888
FARM_MANAGER_TRANSPORT=fm_native
# FARM_MANAGER_TRANSPORT=cdp
FARM_MANAGER_USER=admin
FARM_MANAGER_PASSWORD=
# Lab only — skip TLS verify when using https:// FM URL with a private cert
FARM_MANAGER_TLS_INSECURE=false
FARM_MANAGER_POLL_INTERVAL=3s
# EDGE_CERT_DIR=/certs
# CDP_URL=http://127.0.0.1:9222
# Used only when FARM_MANAGER_URL is empty (dev without live FM):
EDGE_FIXTURE_DIR=/fixtures/fm
EDGE_TOKEN=change-me-edge-token

# === Integrations (optional; empty URL = disabled) ===========================
SPOOLMAN_URL=
SPOOLMAN_API_TOKEN=
MANYFOLD_URL=
MANYFOLD_CLIENT_ID=
MANYFOLD_CLIENT_SECRET=
# MANYFOLD_TOKEN=

# === Costing defaults ========================================================
CURRENCY=USD
MACHINE_RATE_PER_HOUR=0
FILAMENT_PRICE_PER_KG=0
FILAMENT_KG_PER_HOUR=0

# === Public URL hints (web / OIDC) ===========================================
# Browser-facing API base (dev default matches compose host port mapping).
PUBLIC_API_BASE=http://127.0.0.1:18080

# === Updates (host watcher for Admin UI) =====================================
# Gateway writes update requests under OPS_DIR (compose mounts data/ops → /ops).
# On the host: ./scripts/bf update --watch
# OPS_DIR=/ops

# === Install wizard ==========================================================
# Gateway redirects HTML to /setup until install_state.completed.
# SKIP_SETUP_REDIRECT=true
