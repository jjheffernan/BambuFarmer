{
  "repo": "jjheffernan/BambuFarmer",
  "baseBranch": "dev",
  "packageManager": "auto",
  "testCommand": "cd services/web && go test ./...",
  "todoPath": "TODO.md",
  "statePath": ".cursor/after-hours-loop.state.json",
  "morningBriefPath": ".cursor/after-hours-morning-brief.md",
  "cloudLedgerPath": null,
  "runsPath": null,
  "draftPrs": true,
  "maxPrs": 3,
  "allowSkipTests": false,
  "allowEmptyQueue": false,
  "maxConsecutiveBlocked": 3,
  "babysitCi": false,
  "stopOnCiRed": false,
  "safety": {
    "pathDenylist": [".env", ".env.*", "**/*secret*", "**/*credential*"],
    "stopOnAuthWeakening": true,
    "stopOnDirtyTree": true
  },
  "sourcesNotes": "feature-spec: docs/BUILD_OUT.md P0 + Session handoff; github-issues: label ready-for-agent (empty at bootstrap)"
}
